@using BlazorApp1.Auth
@inject SimpleAuthProvider AuthProvider

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <div style="text-align: center;">
                        <img width="600" src="https://i.kym-cdn.com/entries/icons/original/000/002/144/You_Shall_Not_Pass!_0-1_screenshot.jpg" alt="Unauthorized image" />
                        <p>You don't have permission to view this page. Please log in!</p>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <div style="text-align: center;">
                <h1>404: Page Not Found</h1>
                <p>Sorry, the page you're looking for doesn't exist.</p>
            </div>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthProvider.InitializeAsync();
        }
    }
}