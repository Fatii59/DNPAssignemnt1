@page "/posts"
@using BlazorApp1.Services
@using DTOs
@inject IPostService PostService

<div class="create-post-container">
    <h3>Create Post</h3>
    <EditForm Model="@_newPost" OnValidSubmit="HandleValidSubmit" class="post-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="input-group">
            <label for="title">Title*</label>
            <InputText @bind-Value="_newPost.Title" id="title" maxlength="300" placeholder="Enter your title" class="input-field title-input" />
        </div>
        <div class="input-group">
            <label for="body">Body</label>
            <InputTextArea @bind-Value="_newPost.Body" id="body" placeholder="Enter the body of your post" class="input-field body-input" />
        </div>
        
        <button type="submit" class="submit-button">Create Post</button>
    </EditForm>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <p class="success-message">@_successMessage</p>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="error-message">@_errorMessage</p>
    }
</div>

@code {
    private CreatePostDTO _newPost = new CreatePostDTO { UserId = 1 };
    private string _successMessage = string.Empty;
    private string _errorMessage = string.Empty;

    private async Task HandleValidSubmit()
    {
        try
        {
            var createdPost = await PostService.CreatePostAsync(_newPost);
            _newPost = new CreatePostDTO { UserId = 1 }; // Reset form after submission
            _successMessage = "Post created successfully!";
            _errorMessage = ""; // Clear any previous errors
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error creating post: {ex.Message}";
            _successMessage = ""; // Clear any success message
        }
    }
}