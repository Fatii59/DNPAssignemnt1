@page "/post/{postId:int}"
@using BlazorApp1.Services
@using DTOs
@inject ICommentService CommentService
@inject IPostService PostService
@inject AuthenticationStateProvider AuthProvider

<h3>@_postTitle</h3>

<h4>Add a Comment</h4>
<EditForm Model="@_newComment" OnValidSubmit="HandleCommentSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <InputTextArea @bind-Value="_newComment.Body" placeholder="Add your comment" class="input-field body-input" />
    <button type="submit" class="submit-button">Add Comment</button>
</EditForm>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <p class="error-message">@_errorMessage</p>
}
@if (!string.IsNullOrEmpty(_successMessage))
{
    <p class="success-message">@_successMessage</p>
}

@code {
    [Parameter] public int PostId { get; set; } // Capture the PostId from the route

    private string _postTitle = "Loading...";
    private CreateCommentDTO _newComment;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Fetch the post details to display the title
            var post = await PostService.GetPostByIdAsync(PostId);
            _postTitle = post?.Title ?? "Post not found";

            // Initialize the new comment object with the PostId
            _newComment = new CreateCommentDTO
            {
                PostId = PostId,
                UserId = await GetLoggedInUserIdAsync() // Fetch the logged-in user's ID
            };
        }
        catch (Exception ex)
        {
            _postTitle = "Error loading post title";
            _errorMessage = $"Error initializing: {ex.Message}";
        }
    }

    private async Task HandleCommentSubmit()
    {
        try
        {
            await CommentService.CreateCommentAsync(_newComment);
            _successMessage = "Comment added successfully!";
            _newComment.Body = string.Empty; // Clear the form
            _errorMessage = null; // Clear error message
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error adding comment: {ex.Message}";
            _successMessage = null; // Clear success message
        }
    }

    private async Task<int> GetLoggedInUserIdAsync()
    {
        // Access the AuthenticationStateProvider to get the logged-in user's ID
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.Claims.FirstOrDefault(c => c.Type == "Id");

        if (userIdClaim == null)
        {
            throw new Exception("User is not logged in or user ID claim is missing.");
        }

        return int.Parse(userIdClaim.Value);
    }
}
