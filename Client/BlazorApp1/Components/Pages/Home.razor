@page "/"
@using BlazorApp1.Services
@using DTOs
@inject IPostService PostService

<PageTitle>Forum App</PageTitle>

<!-- Main Container for Forum App -->
<div class="forum-app">
    <!-- Title/Heading Section -->
    <header class="forum-header">
        <h1>Forum App</h1>
        <p>Welcome to the Forum! Here are the most recent posts.</p>
    </header>

    <!-- Recent Posts Section -->
    <section class="recent-posts">
        <h2>Recent Posts</h2>

        @if (_recentPosts == null)
        {
            <p class="loading-text">Loading...</p>
        }
        else if (!_recentPosts.Any())
        {
            <p class="no-posts-text">No recent posts available.</p>
        }
        else
        {
            <div class="posts-list">
                @foreach (var post in _recentPosts)
                {
                    <div class="post-card">
                        <h3>
                            <a href="@($"post/{post.Id}")">@post.Title</a>
                        </h3>
                        <p class="post-info">
                            <span>by <strong>@post.UserName</strong></span> | 
                            <span>@post.CreatedDate.ToLocalTime().ToString("g")</span> | 
                            <span>@post.CommentCount comments</span>
                        </p>
                        <p class="post-snippet">
                            <!-- Optional: Show a preview of the post body if needed -->
                            @post.Body.Substring(0, Math.Min(100, post.Body.Length))... 
                        </p>
                    </div>
                }
            </div>
        }
    </section>
</div>

@code {
    private List<PostDTO>? _recentPosts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Fetch recent posts, including the original creation date
            _recentPosts = (await PostService.GetRecentPostsAsync(5)).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading recent posts: {ex.Message}");
        }
    }
}